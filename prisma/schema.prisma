generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phone        String?
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now()) @map("created_at")

  clientAppointments Appointment[] @relation("ClientAppointments")
  staffAppointments  Appointment[] @relation("StaffAppointments")
  workingHours       WorkingHour[]
  staffProfile       Staff?

  @@map("users")
}

enum Role {
  CLIENT
  STAFF
  ADMIN
}

model Staff {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio      String?
  isActive Boolean @default(true) @map("is_active")

  services StaffService[]

  @@map("staff")
}

model Service {
  id              String  @id @default(uuid())
  name            String
  description     String?
  durationMinutes Int     @map("duration_minutes")
  price           Decimal @db.Decimal(10, 2)
  isActive        Boolean @default(true) @map("is_active")

  staffServices StaffService[]
  appointments  Appointment[]

  @@map("services")
}

model StaffService {
  staffId   String @map("staff_id")
  serviceId String @map("service_id")

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model WorkingHour {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int    @map("day_of_week")
  startTime String @map("start_time")
  endTime   String @map("end_time")

  @@map("working_hours")
}

model Appointment {
  id        String            @id @default(uuid())
  clientId  String            @map("client_id")
  staffId   String            @map("staff_id")
  serviceId String            @map("service_id")
  startTime DateTime          @map("start_time")
  endTime   DateTime          @map("end_time")
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now()) @map("created_at")

  client  User    @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  staff   User    @relation("StaffAppointments", fields: [staffId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@map("appointments")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}
